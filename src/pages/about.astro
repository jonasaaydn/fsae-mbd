---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

// このサイトの編集方針
const principles = [
  {
    title: '実務の水準で書く',
    body: 'モデルの式を示すだけでなく、実測データからの係数同定と、そのモデルをいつ信じてはいけないかまで扱います。',
  },
  {
    title: '実行した結果だけを載せる',
    body: 'コードは実際に実行し、得られた出力をそのまま載せます。実行していない出力を「実行結果」として書きません。',
  },
  {
    title: '必要なものを先に示す',
    body: '各章の冒頭に、必要なソフトウェア・Toolbox・前提の数学・前提の章を明示します。読み始めてから詰まらないようにするためです。',
  },
  {
    title: '順序を守る',
    body: '章は前提順に並びます。車両運動から始め、その限界を示してから各要素を作り込み、最後にDILシミュレータへ到達します。',
  },
];
---

<BaseLayout
  title="このサイトについて"
  description="学生フォーミュラ車両のモデルベース開発（MBD）を、車両運動からラップタイムシミュレーション、DILシミュレータまで48章で扱う教科書です。編集方針と運営者情報を掲載しています。"
  canonicalPath="/about/"
>
  <article class="about container">
    <header class="about-head">
      <p class="about-eyebrow">About</p>
      <h1>このサイトについて</h1>
      <p class="about-lead">
        本サイトは、<strong>学生フォーミュラ車両のモデルベース開発（MBD）</strong>を、
        車両運動からラップタイムシミュレーション、DILシミュレータまで<strong>48章</strong>で扱う教科書です。
      </p>
    </header>

    <section class="about-section">
      <h2>運営者</h2>
      <p>
        本サイトは、<strong>レース車両のMBD（モデルベース開発）に携わる現役エンジニアが個人で運営</strong>しています。
        Simulink・CAE・制御・走行データ解析を実務で扱う立場から、「現場と学生チームの双方にとって本当に役立つか」を基準に題材を選んでいます。
      </p>
    </section>

    <section class="about-section">
      <h2>なぜこのサイトが必要か（立ち位置）</h2>
      <p>
        車両運動の体系を、<strong>日本語で・実務の水準で・実行検証つきで</strong>一から学べる教材はほとんどありません。
        多くの資料は式の羅列で終わるか、逆に個別のノウハウの寄せ集めにとどまり、
        前提から積み上げて実装まで到達する体系立った教科書がありませんでした。
        本サイトは、その空白を埋めることを目的としています。
      </p>
    </section>

    <section class="about-section">
      <h2>編集方針 — 記事が満たすべき基準</h2>
      <p>
        本サイトの各章は、次の基準を満たすことを方針としています。
      </p>
      <ul class="principles">
        {principles.map((p) => (
          <li class="principle">
            <span class="principle-title">{p.title}</span>
            <span class="principle-body">{p.body}</span>
          </li>
        ))}
      </ul>
      <p class="about-note">
        誤りや古い情報、リンク切れにお気づきの場合は、出典とあわせてご指摘いただけると助かります。継続的に品質を改善していきます。
      </p>
    </section>

    <section class="about-section">
      <h2>対象読者</h2>
      <p>
        <strong>学生フォーミュラ（FSAE / Formula Student）</strong>でMBD・制御・車両運動を担当する学生を主な対象としています。
        前提知識として、<strong>微積分・線形代数・常微分方程式</strong>の基礎を想定しています。
      </p>
    </section>

    <div class="about-actions">
      <a href={`${base}curriculum`} class="btn btn-primary">目次を見る</a>
      <a href={`${base}ch/01-coordinates`} class="btn btn-outline">第1章から読む</a>
    </div>
  </article>
</BaseLayout>

<style>
  .about {
    max-width: 760px;
    padding-top: 3rem;
    padding-bottom: 3rem;
  }
  .about-head {
    margin-bottom: 2.5rem;
  }
  .about-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin: 0 0 0.5rem;
  }
  .about-head h1 {
    font-size: 2rem;
    margin: 0 0 1rem;
    color: var(--color-navy);
  }
  .about-lead {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-text);
    margin: 0;
  }
  .about-section {
    margin-bottom: 2.25rem;
  }
  .about-section h2 {
    font-size: 1.25rem;
    color: var(--color-navy);
    border-left: 4px solid var(--color-accent);
    padding-left: 0.65rem;
    margin: 0 0 0.9rem;
  }
  .about-section p {
    line-height: 1.85;
    color: var(--color-text);
    margin: 0 0 0.75rem;
  }
  .principles {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: grid;
    gap: 0.75rem;
  }
  .principle {
    background: var(--color-bg-subtle, #f8fafc);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.9rem 1.1rem;
  }
  .principle-title {
    display: block;
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 0.3rem;
  }
  .principle-body {
    display: block;
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }
  .about-note {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .audience {
    line-height: 2;
    padding-left: 1.2rem;
    margin: 0;
  }
  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }
</style>
