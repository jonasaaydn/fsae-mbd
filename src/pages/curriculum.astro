---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getChaptersByPart, getProgress } from '../utils/chapters';

const base = import.meta.env.BASE_URL;
const groups = await getChaptersByPart();
const progress = await getProgress();

const STATUS_LABEL = { planned: '準備中', draft: '執筆中', published: '' } as const;
---

<BaseLayout
  title="目次"
  description="学生フォーミュラ車両のMBD開発を、車両運動から DIL シミュレータまで48章で扱う教科書の目次です。"
  canonicalPath="/curriculum/"
>
  <article class="toc container">
    <header class="toc-head">
      <h1>目次</h1>
      <p class="toc-progress">全 {progress.total} 章のうち {progress.published} 章を公開しています。</p>
    </header>

    {groups.map(({ part, chapters }) => (
      <section class="part" id={`part-${part.id}`}>
        <h2 class="part-title">
          <span class="part-roman">{part.roman}</span>
          {part.title}
          <span class="part-count">{progress.byPart[part.id].published} / {progress.byPart[part.id].total}</span>
        </h2>
        <p class="part-sub">{part.subtitle}</p>
        <ol class="ch-list">
          {chapters.map((c) => (
            <li class:list={['ch-item', `is-${c.data.status}`]}>
              <span class="ch-num">{c.data.chapter}</span>
              {c.data.status === 'published' ? (
                <a href={`${base}ch/${c.slug}/`} class="ch-title">{c.data.title}</a>
              ) : (
                <span class="ch-title">{c.data.title}</span>
              )}
              {c.data.status !== 'published' && (
                <span class="ch-status">{STATUS_LABEL[c.data.status]}</span>
              )}
            </li>
          ))}
        </ol>
      </section>
    ))}
  </article>
</BaseLayout>

<style>
  .toc { max-width: 820px; padding-top: 3rem; padding-bottom: 4rem; }
  .toc-head h1 { font-size: 2rem; margin: 0 0 0.5rem; }
  .toc-progress { font-family: var(--font-mono); font-size: 0.88rem; color: var(--ink-soft); margin: 0 0 2.5rem; }
  .part { margin-bottom: 2.75rem; scroll-margin-top: 5rem; }
  .part-title {
    display: flex; align-items: baseline; gap: 0.65rem; flex-wrap: wrap;
    font-size: 1.2rem; margin: 0 0 0.3rem;
    border-left: 3px solid var(--moss); padding-left: 0.7rem;
  }
  .part-roman {
    font-family: var(--font-mono); font-size: 1rem; font-weight: 700;
    letter-spacing: 0.04em; color: var(--moss);
  }
  .part-count {
    margin-left: auto; font-family: var(--font-mono); font-size: 0.85rem;
    color: var(--ink-soft); font-weight: 500;
  }
  .part-sub { font-size: 0.88rem; color: var(--ink-soft); margin: 0 0 0.9rem 1rem; }
  .ch-list { list-style: none; padding: 0 0 0 1rem; margin: 0; }
  .ch-item {
    display: flex; align-items: baseline; gap: 0.7rem;
    padding: 0.5rem 0; border-bottom: 1px solid var(--rule);
  }
  .ch-num {
    flex-shrink: 0; width: 2rem; text-align: right;
    font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink-soft);
  }
  .ch-title { font-size: 0.95rem; }
  .ch-item a.ch-title { color: var(--moss); text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--moss) 45%, transparent); text-underline-offset: 0.15em; }
  .ch-item a.ch-title:hover { text-decoration-color: var(--moss); }
  .is-planned .ch-title, .is-draft .ch-title { color: var(--ink-soft); }
  .ch-status {
    margin-left: auto; flex-shrink: 0;
    font-size: 0.7rem; color: var(--ink);
    border: 1px solid var(--amber); background: var(--amber-fill);
    border-radius: var(--radius-sm);
    padding: 0.15em 0.55em;
  }
</style>
