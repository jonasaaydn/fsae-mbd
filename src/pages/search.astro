---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="章を検索"
  description="学生フォーミュラのモデルベース開発 全48章をキーワードで検索できます"
  canonicalPath="/search/"
>
  <div class="container search-page">
    <div class="page-header">
      <h1>章を検索</h1>
      <p class="page-desc">車両運動・タイヤ・空力・制御・DILシミュレータなど、全48章をキーワードで検索</p>
    </div>
    <div id="search"></div>
  </div>
</BaseLayout>

<link rel="stylesheet" href={`${base}pagefind/pagefind-ui.css`} />
<script define:vars={{ base }}>
  const s = document.createElement('script');
  s.src = base + 'pagefind/pagefind-ui.js';
  s.onload = () => {
    new PagefindUI({
      element: '#search',
      showImages: false,
      resetStyles: false,
    });
  };
  document.head.appendChild(s);
</script>

<style>
  .page-header {
    padding: 2.5rem 0 2rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 2rem;
  }
  .page-header h1 { margin-bottom: 0.5rem; }
  .page-desc {
    font-size: 0.95rem;
    color: var(--ink-soft);
    line-height: 1.8;
    margin: 0;
  }
  .search-page {
    padding-bottom: 4rem;
    min-height: 60vh;
  }

  /* Pagefind UI の色をサイトデザインに合わせる */
  :root {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--clay-text);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--paper);
    --pagefind-ui-border: var(--rule);
    --pagefind-ui-tag: var(--paper-raised);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 6px;
    --pagefind-ui-font: var(--font-sans);
  }

  /* 検索入力欄のフォーカス色 */
  :global(.pagefind-ui__search-input:focus) {
    outline-color: var(--clay-text);
  }
  :global(.pagefind-ui__search-clear) {
    color: var(--ink-soft);
  }
</style>
