---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getChaptersByPart, getProgress } from '../utils/chapters';

const base = import.meta.env.BASE_URL;
const groups = await getChaptersByPart();
const progress = await getProgress();
const firstPublished = groups.flatMap((g) => g.chapters).find((c) => c.data.status === 'published');
---

<BaseLayout title="ホーム">
  <section class="hero container">
    <h1>学生フォーミュラのモデルベース開発</h1>
    <p class="lead">
      タイヤが力を出す仕組みから、ラップタイムシミュレーション、ドライバーが乗って評価する
      DIL シミュレータまで。実務のレース車両開発と同じ水準で、順を追って扱います。
    </p>
    <p class="progress">全 {progress.total} 章のうち {progress.published} 章を公開しています。</p>
    <div class="actions">
      {firstPublished && <a href={`${base}ch/${firstPublished.slug}/`} class="btn btn-primary">第1章から読む</a>}
      <a href={`${base}curriculum/`} class="btn btn-outline">目次を見る</a>
    </div>
  </section>

  <section class="vmodel container" aria-labelledby="vmodel-heading">
    <h2 id="vmodel-heading" class="vmodel-heading">V字モデルで見る、6部の進捗</h2>
    <p class="vmodel-sub">
      V字モデルは、要件から実装・検証までをたどるMBDの基本工程図です。本サイトの6部はこの工程の順に並び、
      各部の公開章数がそのまま読み進められる範囲になります。
    </p>

    <div class="vgrid" role="list">
      {groups.map(({ part, chapters }) => {
        const prog = progress.byPart[part.id];
        const pct = prog.total > 0 ? Math.round((prog.published / prog.total) * 100) : 0;
        const status = prog.published === 0 ? 'is-empty' : prog.published >= prog.total ? 'is-complete' : 'is-active';
        return (
          <a
            href={`${base}curriculum/#part-${part.id}`}
            class:list={['vnode', status]}
            role="listitem"
          >
            <span class="vnode-roman">{part.roman}</span>
            <span class="vnode-title">{part.title}</span>
            <span class="vnode-frac">{prog.published} / {prog.total}<span class="vnode-unit">章</span></span>
            <span class="vnode-bar" aria-hidden="true"><span class="vnode-fill" style={`width:${pct}%`}></span></span>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: 4rem 1.25rem 3rem; max-width: 760px; }
  .hero h1 { font-size: clamp(1.7rem, 4.5vw, 2.5rem); margin: 0 0 1.1rem; line-height: 1.45; }
  .lead { line-height: 1.95; color: var(--ink); margin: 0 0 1.25rem; }
  .progress { font-family: var(--font-mono); font-size: 0.85rem; color: var(--ink-soft); margin: 0 0 1.75rem; }
  .actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }

  /* ============================================================
     V字モデル計器（トップページの主役）
     ============================================================ */
  .vmodel { padding: 1.5rem 1.25rem 5rem; }
  .vmodel-heading { font-size: clamp(1.3rem, 3vw, 1.6rem); margin: 0 0 0.75rem; }
  .vmodel-sub {
    max-width: 42em; color: var(--ink-soft); line-height: 1.9;
    margin: 0 0 2.5rem; font-size: 0.94rem;
  }

  .vgrid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: repeat(3, auto);
    grid-template-areas:
      "n1 .  .  .  . n6"
      ".  n2 .  . n5 ."
      ".  .  n3 n4 . .";
    column-gap: clamp(0.5rem, 1.6vw, 1.25rem);
    row-gap: 1.1rem;
  }
  .vnode:nth-of-type(1) { grid-area: n1; }
  .vnode:nth-of-type(2) { grid-area: n2; }
  .vnode:nth-of-type(3) { grid-area: n3; }
  .vnode:nth-of-type(4) { grid-area: n4; }
  .vnode:nth-of-type(5) { grid-area: n5; }
  .vnode:nth-of-type(6) { grid-area: n6; }

  .vnode {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.9rem 0.85rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--paper);
    transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
  }
  .vnode:hover { border-color: var(--clay); transform: translateY(-2px); }
  .vnode.is-active,
  .vnode.is-complete {
    border-color: var(--clay);
    background: var(--clay-fill);
  }

  .vnode-roman {
    font-family: var(--font-mono); font-weight: 700; font-size: 1.3rem;
    color: var(--clay-text); line-height: 1;
  }
  .vnode-title {
    font-family: var(--font-serif); font-size: 0.86rem; line-height: 1.5;
    color: var(--ink);
    min-height: 2.6em;
  }
  .vnode-frac {
    font-family: var(--font-mono); font-size: 0.8rem; font-weight: 600; color: var(--ink);
  }
  .vnode-unit { font-family: var(--font-sans); font-weight: 400; color: var(--ink-soft); margin-left: 0.2em; font-size: 0.85em; }
  .vnode-bar {
    display: block; height: 4px; border-radius: 2px;
    background: var(--rule); overflow: hidden;
  }
  .vnode-fill { display: block; height: 100%; background: var(--clay); }

  /* ---- narrow screens: V collapses to a single vertical list, top → bottom in part order ---- */
  @media (max-width: 720px) {
    .vgrid {
      grid-template-columns: 1fr;
      grid-template-areas:
        "n1"
        "n2"
        "n3"
        "n4"
        "n5"
        "n6";
      row-gap: 0.75rem;
    }
    .vnode { flex-direction: row; align-items: center; gap: 0.9rem; }
    .vnode-title { min-height: 0; flex: 1; }
    .vnode-bar { width: 3.5rem; flex-shrink: 0; }
  }
</style>
