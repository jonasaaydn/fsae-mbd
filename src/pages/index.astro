---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ToolCard from '../components/ToolCard.astro';
import { tools } from '../data/tools';
import { CATEGORIES, categoryToSlug } from '../utils/categories';
import { getReadingTime } from '../utils/reading-time';

const base = import.meta.env.BASE_URL;
const allPosts = await getCollection('blog');
const latestPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

const featuredPosts = allPosts
  .filter((p) => p.data.importance === 'high')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const highlightTools = tools.filter((t) => t.mbd_relevance === 'high').slice(0, 4);

// 役割別記事カウント（チームの担当から探すセクション用）
const aeroPosts    = allPosts.filter((p) => p.data.category === 'CAE / Simulation AI');
const mbdPosts     = allPosts.filter((p) => p.data.category === 'MBD / Simulink');
const racePosts    = allPosts.filter((p) => p.data.category === 'Race Engineering Use Cases');
const studentPosts = allPosts.filter((p) => p.slug.startsWith('student-formula-'));
---

<BaseLayout title="ホーム">
  <!-- Hero: Telemetry Convergence -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="hero-eyebrow"><span class="eb-tick"></span>MBD × RACE ENGINEERING × AI</p>
        <h1 class="hero-title">解に、<span class="accent">速く</span>収束する。</h1>
        <p class="hero-desc">
          レース車両開発・MBD・CAE・制御に効く AI ツールを、<strong>実装コードつき・日本語</strong>で。
          設計の反復を、そのまま開発時間の短縮に変える技術ブログです。
        </p>
        <div class="hero-actions">
          <a href={`${base}blog`} class="hero-btn hero-btn-primary">記事を読む</a>
          <a href={`${base}guide/student-formula`} class="hero-btn hero-btn-ghost">学生フォーミュラ実践ガイド</a>
          <a href={`${base}tools`} class="hero-textlink">AIツール一覧 →</a>
        </div>
      </div>

      <figure class="scope">
        <figcaption class="scope-head">
          <span>STEP RESPONSE · 開発の収束</span>
          <span class="scope-live"><span class="scope-live-dot"></span>LIVE</span>
        </figcaption>
        <div class="scope-plot">
          <svg viewBox="0 0 560 360" role="img"
               aria-label="AI支援によって開発が目標精度へ速く収束することを示すステップ応答グラフ。手作業のトレースは緩やかに上がり、AI支援のトレースは急峻に立ち上がって目標線に到達する。"
               preserveAspectRatio="xMidYMid meet">
            <line class="grid-line" x1="148" y1="28" x2="148" y2="312" />
            <line class="grid-line" x1="242" y1="28" x2="242" y2="312" />
            <line class="grid-line" x1="336" y1="28" x2="336" y2="312" />
            <line class="grid-line" x1="430" y1="28" x2="430" y2="312" />
            <line class="grid-line" x1="54" y1="99" x2="528" y2="99" />
            <line class="grid-line" x1="54" y1="170" x2="528" y2="170" />
            <line class="grid-line" x1="54" y1="241" x2="528" y2="241" />

            <line class="axis-line" x1="54" y1="28" x2="54" y2="312" />
            <line class="axis-line" x1="54" y1="312" x2="528" y2="312" />

            <line class="target-line" x1="54" y1="70" x2="528" y2="70" />
            <text class="plot-label" x="524" y="63" text-anchor="end">目標精度</text>

            <path class="trace trace-ref draw" pathLength="1" d="M54,312 C170,300 300,250 528,150" />
            <path class="trace trace-hot draw" pathLength="1" d="M54,312 C120,302 150,120 214,74 L528,70" />

            <g class="scope-marker">
              <circle class="marker-ring pulse" cx="214" cy="72" r="5" />
              <circle class="marker-dot" cx="214" cy="72" r="3.2" />
            </g>
            <text class="anno" x="228" y="58">AI支援 ▸ 数分で収束</text>

            <g transform="translate(72,42)">
              <line class="leg-hot" x1="0" y1="0" x2="22" y2="0" />
              <text class="legend-t" x="29" y="4">AI支援（実装コード付き）</text>
              <line class="leg-ref" x1="0" y1="18" x2="22" y2="18" />
              <text class="legend-t" x="29" y="22">手作業</text>
            </g>

            <text class="plot-label" x="291" y="342" text-anchor="middle">反復回数・工数 →</text>
            <text class="plot-label" text-anchor="middle" transform="translate(20,170) rotate(-90)">精度・収束 →</text>
          </svg>
        </div>
        <div class="scope-readouts">
          <div class="ch"><span class="ch-id">CH1</span><span class="ch-name">CFD反復</span><span class="ch-delta"><span class="was">8–12h</span> ▸ <span class="now">数分</span></span></div>
          <div class="ch"><span class="ch-id">CH2</span><span class="ch-name">Simulink構築</span><span class="ch-delta"><span class="was">1–2週</span> ▸ <span class="now">半日</span></span></div>
          <div class="ch"><span class="ch-id">CH3</span><span class="ch-name">データ解析</span><span class="ch-delta"><span class="was">2–3h</span> ▸ <span class="now">15分</span></span></div>
          <div class="ch"><span class="ch-id">CH4</span><span class="ch-name">PID調整</span><span class="ch-delta"><span class="was">10–15分</span> ▸ <span class="now">30秒</span></span></div>
        </div>
      </figure>
    </div>
  </section>

  <!-- ── 悩みから探す（Pain Points） ── -->
  <section class="pain-points">
    <div class="container">
      <div class="section-header">
        <h2>こんな悩みはありませんか？</h2>
        <p class="pain-desc">学生フォーミュラチームでよく直面する4つの課題と、AIによる解決策・実績値</p>
      </div>
      <div class="pain-grid">

        <!-- CFD解析 -->
        <a href={`${base}blog/student-formula-cfd-ai-surrogate-2026`} class="pain-card">
          <p class="pain-quote">CFD 1回のシミュレーションに 8〜12時間かかって、形状最適化が間に合わない</p>
          <span class="pain-tool">Ansys SimAI・Gaussian Process サロゲートモデル</span>
          <div class="pain-metric">
            <div class="metric-before">
              <span class="metric-val">8〜12時間</span>
              <span class="metric-label">従来の1回実行</span>
            </div>
            <span class="metric-arrow">→</span>
            <div class="metric-after">
              <span class="metric-val">数分</span>
              <span class="metric-label">学習後のAI予測</span>
            </div>
          </div>
          <span class="pain-cta">この記事で解決する →</span>
        </a>

        <!-- Simulink -->
        <a href={`${base}blog/student-formula-simulink-copilot-vehicle-dynamics-2026`} class="pain-card">
          <p class="pain-quote">Simulinkのブロック線図をどう繋げばいいか分からなくて、3日かけても動かない</p>
          <span class="pain-tool">Simulink Copilot（MATLAB R2024b以降・学校ライセンス対応）</span>
          <div class="pain-metric">
            <div class="metric-before">
              <span class="metric-val">1〜2週間</span>
              <span class="metric-label">初心者の構築時間</span>
            </div>
            <span class="metric-arrow">→</span>
            <div class="metric-after">
              <span class="metric-val">半日</span>
              <span class="metric-label">Copilotで自動生成</span>
            </div>
          </div>
          <span class="pain-cta">この記事で解決する →</span>
        </a>

        <!-- 走行データ解析 -->
        <a href={`${base}blog/student-formula-claude-code-lap-data-analysis-2026`} class="pain-card">
          <p class="pain-quote">テスト走行後のCSV解析に毎回2〜3時間かかって、次のセッション準備が遅れる</p>
          <span class="pain-tool">Claude Code + Python（無料で試せる）</span>
          <div class="pain-metric">
            <div class="metric-before">
              <span class="metric-val">2〜3時間</span>
              <span class="metric-label">手作業の解析</span>
            </div>
            <span class="metric-arrow">→</span>
            <div class="metric-after">
              <span class="metric-val">15分</span>
              <span class="metric-label">自動レポート生成</span>
            </div>
          </div>
          <span class="pain-cta">この記事で解決する →</span>
        </a>

        <!-- PIDゲイン -->
        <a href={`${base}blog/student-formula-cursor-matlab-mcp-control-design-2026`} class="pain-card">
          <p class="pain-quote">PIDゲインの調整が手探りで、1回変えるたびに10〜15分かかって時間が溶ける</p>
          <span class="pain-tool">Cursor + MATLAB MCP（自然言語でゲイン調整）</span>
          <div class="pain-metric">
            <div class="metric-before">
              <span class="metric-val">10〜15分/回</span>
              <span class="metric-label">手動調整サイクル</span>
            </div>
            <span class="metric-arrow">→</span>
            <div class="metric-after">
              <span class="metric-val">30秒</span>
              <span class="metric-label">チャットで即修正</span>
            </div>
          </div>
          <span class="pain-cta">この記事で解決する →</span>
        </a>

      </div>
    </div>
  </section>

  <!-- ── 開発フロー × AI（Case B） ── -->
  <section class="dev-flow">
    <div class="container dev-flow-inner">
      <div class="dev-flow-head">
        <span class="flow-eyebrow">Development Flow × AI</span>
        <h2 class="dev-flow-title">車両開発のどのフェーズでAIが使えるか</h2>
        <p class="dev-flow-desc">設計・シミュレーション・制御設計・データ解析まで、開発の全工程でAIが活躍します</p>
      </div>

      <div class="flow-track">
        <!-- Step 01 -->
        <div class="flow-step">
          <div class="step-badge">01</div>
          <div class="step-body">
            <h3>設計</h3>
            <p>形状生成・軽量化最適化</p>
            <ul class="step-tools">
              <li>nTop — ラティス構造</li>
              <li>AI CAD — 形状自動生成</li>
            </ul>
          </div>
        </div>
        <div class="flow-arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>

        <!-- Step 02 -->
        <div class="flow-step">
          <div class="step-badge">02</div>
          <div class="step-body">
            <h3>CFD・FEMシミュレーション</h3>
            <p>空力・構造・サロゲートモデル</p>
            <ul class="step-tools">
              <li>Ansys SimAI — 高速CFD</li>
              <li>STAR-CCM+ AI — 空力最適化</li>
              <li>Neural Concept — DL代替</li>
            </ul>
          </div>
        </div>
        <div class="flow-arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>

        <!-- Step 03 -->
        <div class="flow-step">
          <div class="step-badge">03</div>
          <div class="step-body">
            <h3>制御・MBD開発</h3>
            <p>Simulinkモデル・制御則自動設計</p>
            <ul class="step-tools">
              <li>Simulink Copilot</li>
              <li>MATLAB Copilot</li>
              <li>Claude Code + MCP</li>
            </ul>
          </div>
        </div>
        <div class="flow-arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>

        <!-- Step 04 -->
        <div class="flow-step">
          <div class="step-badge">04</div>
          <div class="step-body">
            <h3>テスト走行・データ解析</h3>
            <p>テレメトリ解析・ラップ比較・改善</p>
            <ul class="step-tools">
              <li>Claude Code — CSV自動解析</li>
              <li>Python AI — 改善点抽出</li>
              <li>Monolith AI — セットアップ最適化</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── チームの担当から探す（Case A） ── -->
  <section class="team-roles-wrap">
    <div class="container">
      <div class="section-header">
        <h2>チームの担当から探す</h2>
        <p class="roles-desc">学生フォーミュラチームの役割別に、すぐ使えるAIツール記事を紹介します</p>
      </div>
      <div class="role-grid">

        <!-- 空力・CFD担当 -->
        <a href={`${base}categories/cae-simulation-ai`} class="role-card">
          <div class="role-icon">
            <svg viewBox="0 0 32 32" width="36" height="36" fill="none">
              <path d="M3 16 C7 8,11 24,16 16 C21 8,25 24,29 16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none"/>
              <path d="M3 10 C7 2,11 18,16 10 C21 2,25 18,29 10" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" fill="none" opacity="0.4"/>
              <path d="M3 22 C7 14,11 30,16 22 C21 14,25 30,29 22" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" fill="none" opacity="0.4"/>
            </svg>
          </div>
          <h3>空力・CFD担当</h3>
          <p>フロントウィング・ディフューザーのCFD解析精度向上と形状最適化の自動化</p>
          <span class="role-count">{aeroPosts.length}本の記事を見る →</span>
        </a>

        <!-- 制御・MBD担当 -->
        <a href={`${base}categories/mbd-simulink`} class="role-card">
          <div class="role-icon">
            <svg viewBox="0 0 32 32" width="36" height="36" fill="none">
              <rect x="1"  y="11" width="8" height="8" rx="2" stroke="currentColor" stroke-width="1.8" fill="none"/>
              <rect x="12" y="11" width="8" height="8" rx="2" stroke="currentColor" stroke-width="1.8" fill="none"/>
              <rect x="23" y="11" width="8" height="8" rx="2" stroke="currentColor" stroke-width="1.8" fill="none"/>
              <line x1="9"  y1="15" x2="12" y2="15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <line x1="20" y1="15" x2="23" y2="15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <line x1="5"  y1="11" x2="5"  y2="5"  stroke="currentColor" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.5"/>
              <path d="M5 5 Q5 3 27 3 Q27 3 27 5" stroke="currentColor" stroke-width="1.2" fill="none" opacity="0.5"/>
              <line x1="27" y1="5" x2="27" y2="11" stroke="currentColor" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.5"/>
            </svg>
          </div>
          <h3>制御・MBD担当</h3>
          <p>Simulinkモデルの自動生成・トラクションコントロール・PID制御則の設計支援</p>
          <span class="role-count">{mbdPosts.length}本の記事を見る →</span>
        </a>

        <!-- 走行データ解析担当 -->
        <a href={`${base}categories/race-engineering-use-cases`} class="role-card">
          <div class="role-icon">
            <svg viewBox="0 0 32 32" width="36" height="36" fill="none">
              <polyline points="2,24 6,11 10,19 14,8 18,20 22,12 28,22" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
              <line x1="2" y1="26" x2="30" y2="26" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.35"/>
              <line x1="2" y1="6"  x2="2"  y2="26" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.35"/>
            </svg>
          </div>
          <h3>走行データ解析担当</h3>
          <p>テスト走行後のCSVを自動解析・ラップタイム比較・ドライバーへのフィードバック生成</p>
          <span class="role-count">{racePosts.length}本の記事を見る →</span>
        </a>

        <!-- 学生フォーミュラ実践 -->
        <a href={`${base}categories/race-engineering-use-cases`} class="role-card role-card-student">
          <div class="role-icon">
            <svg viewBox="0 0 32 32" width="36" height="36" fill="none">
              <circle cx="16" cy="16" r="12" stroke="currentColor" stroke-width="2" fill="none"/>
              <circle cx="16" cy="16" r="3.5" fill="currentColor" opacity="0.9"/>
              <line x1="16" y1="12.5" x2="16" y2="5"   stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <line x1="12.5" y1="13.5" x2="6.5" y2="10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <line x1="12.5" y1="18.5" x2="6.5" y2="22" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <line x1="19.5" y1="13.5" x2="25.5" y2="10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <line x1="19.5" y1="18.5" x2="25.5" y2="22" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <line x1="16" y1="19.5" x2="16" y2="27" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </div>
          <h3>学生フォーミュラ 実践ガイド</h3>
          <p>実際に動くコードとステップバイステップ手順で今日から試せる実践シリーズ</p>
          <span class="role-count">{studentPosts.length}本の実践記事を見る →</span>
        </a>

      </div>
    </div>
  </section>

  <div class="container">
    <!-- Latest Articles -->
    <section class="section">
      <div class="section-header">
        <h2>最新記事</h2>
        <a href={`${base}blog`} class="section-link">すべて見る →</a>
      </div>
      <div class="grid-2">
        {latestPosts.map((post) => (
          <ArticleCard
            slug={post.slug}
            title={post.data.title}
            date={post.data.date}
            category={post.data.category}
            tags={post.data.tags}
            tool={post.data.tool}
            importance={post.data.importance}
            summary={post.data.summary}
            readingTime={getReadingTime(post.body)}
          />
        ))}
      </div>
    </section>

    <!-- Featured AI Tools -->
    <section class="section">
      <div class="section-header">
        <h2>注目AIツール</h2>
        <a href={`${base}tools`} class="section-link">全ツール一覧 →</a>
      </div>
      <div class="grid-2">
        {highlightTools.map((tool) => (
          <ToolCard tool={tool} />
        ))}
      </div>
    </section>

    <!-- Featured -->
    <section class="section mbd-section">
      <div class="section-header">
        <h2>実践事例・注目記事</h2>
        <a href={`${base}categories/race-engineering-use-cases`} class="section-link">もっと見る →</a>
      </div>
      <div class="grid-3">
        {featuredPosts.map((post) => (
          <ArticleCard
            slug={post.slug}
            title={post.data.title}
            date={post.data.date}
            category={post.data.category}
            tags={post.data.tags}
            tool={post.data.tool}
            importance={post.data.importance}
            summary={post.data.summary}
            readingTime={getReadingTime(post.body)}
          />
        ))}
      </div>
    </section>

    <!-- Categories -->
    <section class="section">
      <div class="section-header">
        <h2>カテゴリ</h2>
      </div>
      <div class="category-grid">
        {CATEGORIES.map((cat) => (
          <a href={`${base}categories/${categoryToSlug(cat)}`} class="category-chip">
            {cat}
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* ══ Hero: Telemetry Convergence ══ */
  .hero {
    position: relative;
    --scope-ink: #eaf1f8;
    --scope-dim: #7e90a6;
    --hot: #ff5b43;
    --ref: #38e0ce;
    --grid: rgba(126, 150, 190, 0.12);
    background: radial-gradient(130% 120% at 12% -10%, #12202f 0%, #0b111a 58%);
    color: var(--scope-ink);
    padding: clamp(2.5rem, 6vw, 5rem) 0 clamp(2.5rem, 5vw, 4.25rem);
    overflow: hidden;
    border-bottom: 1px solid #1b2735;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(1.75rem, 4vw, 3.25rem);
    align-items: center;
  }

  .hero-copy {
    animation: hero-rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: var(--hot);
    margin: 0 0 1.1rem;
  }
  .eb-tick {
    width: 20px;
    height: 2px;
    background: var(--hot);
    box-shadow: 0 0 8px var(--hot);
  }

  .hero-title {
    font-family: 'Zen Kaku Gothic New', var(--font-sans, sans-serif);
    font-size: clamp(2.1rem, 5.8vw, 3.6rem);
    font-weight: 900;
    line-height: 1.14;
    letter-spacing: 0.01em;
    color: #ffffff;
    margin: 0 0 1.15rem;
  }
  .hero-title .accent {
    color: var(--hot);
  }

